{
  "name": "@soliventa-learn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "production:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-production-env.ps1",
    "production:validate": "node --env-file-if-exists=.env.production.local scripts/validate-production-readiness.mjs",
    "production:provision-demos": "node --env-file-if-exists=.env.production.local scripts/provision-production-demos.mjs",
    "production:deploy": "node --env-file-if-exists=.env.production.local scripts/deploy-production.mjs",
    "production:clear-demo-cache": "node --env-file-if-exists=.env.production.local scripts/clear-production-demo-cache.mjs",
    "production:verify-demos": "node --env-file-if-exists=.env.production.local scripts/verify-production-demos.mjs",
    "production:provision-meridian-family": "node --env-file-if-exists=.env.production.local scripts/provision-meridian-family-demo.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "contract:generate": "tsx scripts/openapi.ts",
    "contract:check": "tsx scripts/openapi.ts --check",
    "contract:compatibility": "node scripts/check-contract-compatibility.mjs",
    "bootstrap:measure": "node scripts/measure-bootstrap.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "fixtures:hosted": "node scripts/provision-hosted-fixtures.mjs",
    "fixtures:verify": "node scripts/verify-hosted-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/security",
    "test:hosted": "cross-env RUN_HOSTED_INTEGRATION=1 vitest run tests/integration/hosted-fixtures.test.ts",
    "test:performance": "k6 run tests/performance/public-bootstrap.k6.js",
    "phase14:status": "node scripts/phase-14-status.mjs",
    "phase14:enforce": "node scripts/phase-14-status.mjs --enforce",
    "staging:tenants": "node scripts/provision-staging-tenants.mjs",
    "phase15:status": "node scripts/phase-15-status.mjs",
    "phase15:enforce": "node scripts/phase-15-status.mjs --enforce",
    "check": "pnpm format:check && pnpm lint && pnpm check:branding && pnpm check:boundaries && pnpm check:observability && pnpm contract:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@supabase/supabase-js": "^2.110.0",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "supabase": "2.115.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.20.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
