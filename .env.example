APP_ENV=development
APP_ORIGIN=http://localhost:4321
PORTAL_ORIGIN=http://localhost:5173
# Comma-separated central platform hosts; custom school hosts are resolved from tenant_domains.
PLATFORM_HOSTNAMES=localhost,api.soliventa.localhost
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only sb_secret_... key. Store it with `wrangler secret put`; never expose it to a frontend.
SUPABASE_SECRET_KEY=
PREVIEW_TOKEN_SECRET=replace-with-at-least-32-random-characters
PREVIEW_ORIGIN=http://preview.soliventa.localhost
PLATFORM_BASE_DOMAIN=soliventa.localhost
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Leave Cloudflare values empty for local-only testing; configure them after purchasing a domain.
CLOUDFLARE_SAAS_TARGET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
# Must use a sender on a domain verified in Resend, for example notifications@learn.soliventa.tech.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# AI lesson pilot: server-only secret; no paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LESSON_AI_DAILY_LIMIT=45
LESSON_AI_SCHOOL_DAILY_LIMIT=10
